// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Requests {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  requestorName   String   @db.String
  itemRequested   String   @db.String
  createdDate     DateTime @default(now())
  lastEditedDate  DateTime @default(now())
  status          Status   @default(pending)

  @@map("requests")
}

enum Status {
  pending
  completed
  approved
  rejected
}